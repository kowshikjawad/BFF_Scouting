# ShonarTalent AI environment configuration
# Copy to .env and fill in real values before running.

# --- Application ---
APP_ENV=development
LOG_LEVEL=INFO

# --- Data storage ---
# SQLite is the zero-config default; switch to PostgreSQL for production.
DATABASE_URL=sqlite:///./data/processed/shonartalent.db
# DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/shonartalent

# --- Data ingestion (scrapers) ---
# soccerdata / FBref may require these for rate limits and source access.
SOCCERDATA_LEAGUE=BAN-BPL
SCRAPER_CRON_SCHEDULE=0 3 * * 1   # weekly Monday 03:00 (during active seasons)
SCRAPER_USER_AGENT=ShonarTalentAI/0.1 (+contact@example.com)

# --- ML / vector engine ---
ML_MIN_MATCHES=5          # minimum 90s-played floor before a player enters similarity index
SIMILARITY_TOP_K=5        # FR-3.3 top-N similar players returned
SIMILARITY_SCORE_THRESHOLD=0.0

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000